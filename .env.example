# Copy to .env and fill in your Alpaca PAPER credentials.
# NEVER put live/funded keys here. This project hard-fails if the base URL
# is not a paper endpoint.
#
#   cp .env.example .env
#
ALPACA_API_KEY_PAPER=your_paper_api_key_here
ALPACA_SECRET_KEY_PAPER=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional overrides (defaults shown)
# ALPACA_DATA_FEED=iex           # iex (free) or sip (paid)
# MARKET_DB_PATH=data/market.db
# LOG_DIR=logs
# LOG_LEVEL=INFO
