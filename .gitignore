# Secrets — never commit
.env

# Null validation records (validation/<name>.json) ARE committed — the Null wall
# needs them in the repo. Locally-generated editing templates are user-only.
validation/*.template.json

# Local databases
/data/*.db
/data/*.db-journal
/data/*.db-wal

# Logs
/logs/*
!/logs/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
